==================================================
STEP 1 : Create UserContext.jsx
==================================================

src/context/UserContext.jsx

import { createContext, useContext, useState } from "react";

const UserContext = createContext(null);

export function UserProvider({ children }) {

    const [username, setUsername] = useState("Ajay");

    return (

        <UserContext.Provider
            value={{ username, setUsername }}
        >

            {children}

        </UserContext.Provider>

    );

}

--------------------------------------------------

Custom Hook:

export function useUser() {

    const context = useContext(UserContext);

    if (!context) {

        throw new Error(
            "useUser must be inside UserProvider"
        );

    }

    return context;

}

==================================================
What is happening?
==================================================

createContext(null)
→ creates communication channel

UserProvider
→ provides global username data

value={{ username, setUsername }}
→ shares BOTH:
   - data
   - function to update data

{children}
→ means:
everything wrapped inside UserProvider

useUser()
→ reusable wrapper around useContext()

==================================================
STEP 2 : Wrap inside main.jsx
==================================================

Before:
Only ThemeProvider existed.

Now:
Add UserProvider also.

--------------------------------------------------

main.jsx

import { StrictMode } from "react";
import { createRoot } from "react-dom/client";

import "bootstrap/dist/css/bootstrap.min.css";
import "./index.css";

import App from "./App.jsx";

import { ThemeProvider } from "./context/ThemeContext.jsx";

import { UserProvider } from "./context/UserContext.jsx";

createRoot(document.getElementById("root")).render(

  <StrictMode>

    <ThemeProvider>

      <UserProvider>

        <App />

      </UserProvider>

    </ThemeProvider>

  </StrictMode>

);

==================================================
Why wrapping in main.jsx?
==================================================

Because:

main.jsx
is top/root level.

So entire app gets access to context.

--------------------------------------------------

Flow:

main.jsx
   ↓
UserProvider
   ↓
App
   ↓
All Components

==================================================
STEP 3 : Use Context inside GlobalContext.jsx
==================================================

Replace OLD GlobalContext.jsx completely.

--------------------------------------------------

components/GlobalContext.jsx

import { useUser } from "../context/UserContext";

function GlobalContext() {

    const { username, setUsername } = useUser();

    return (

        <div>

            <h3>Global Context</h3>

            <p>
                <strong>Hello, {username}</strong>
            </p>

            <button
                className="btn btn-primary me-2"
                onClick={() => setUsername("Bob")}
            >
                Switch to Bob
            </button>

            <button
                className="btn btn-secondary"
                onClick={() => setUsername("Sam")}
            >
                Switch to Sam
            </button>

        </div>

    );

}

export default GlobalContext;

==================================================
What changed?
==================================================

OLD way:
- createContext inside component file
- Provider inside component file

NEW Global Context way:
- Context separated globally
- Provider wrapped at root
- Any component can use context directly

==================================================
Very Important Flow
==================================================

UserContext.jsx
   ↓
creates global context

main.jsx
   ↓
wraps app with UserProvider

GlobalContext.jsx
   ↓
uses useUser()

==================================================
Why Custom Hook?
==================================================

Instead of writing:

const context = useContext(UserContext);

everywhere,

we write:

const { username } = useUser();

Cleaner and reusable.

