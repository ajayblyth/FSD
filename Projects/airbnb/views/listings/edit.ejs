<% layout("/layout/boilerplate") %>
<h3>Edit the Listing</h3>

<form method="POST" action="/listings/<%= listing._id %>?_method=PUT">

<div>
<label for="title">Title:</label>
<input type="text" id="title" name="title" value="<%= listing.title %>">
</div>

<div>
<label for="description">Description:</label>
<textarea id="description" name="description"><%= listing.description %></textarea>
</div>

<div>
<label for="image">Image:</label>
<input type="text" id="image" name="image" value="<%= listing.image %>">
</div>

<div>
<label for="location">Location:</label>
<input type="text" id="location" name="location" value="<%= listing.location %>">
</div>

<div>
<label for="country">Country:</label>
<input type="text" id="country" name="country" value="<%= listing.country %>">
</div>

<button type="submit">Update Listing</button>

</form>