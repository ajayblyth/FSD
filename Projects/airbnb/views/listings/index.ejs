<% layout("/layout/boilerplate") %>
<h3> All Listings </h3>

<div class="row">
<% for(let listing of listings) { %>

<div class="col-md-4 mb-3">
    <a href="/listings/<%= listing._id %>" style="text-decoration: none; color: inherit;">
        <div class="card">
            <img src="<%= listing.image %>" class="card-img-top" alt="listing">
            <div class="card-body">
                <p class="card-text">
                    <b><%= listing.title %></b> <br>
                    &#8377; <%= listing.price.toLocaleString() %> / night
                </p>
            </div>
        </div>
    </a>
</div>

<% } %>
</div>

